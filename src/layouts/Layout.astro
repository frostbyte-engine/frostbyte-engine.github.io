---
interface Props { title: string; active?: 'home' | 'gallery' | 'others' | 'demo'; }
const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHomePage = active === 'home' || active === 'gallery';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.ico`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="name" href={`${base}/`}>frostbyte</a>
      <nav>
        <a data-section="home" class:list={{ active: active === 'home' }} href={`${base}/#home`}>Home</a>
        <a data-section="gallery" class:list={{ active: active === 'gallery' }} href={`${base}/#gallery`}>Gallery</a>
        <a data-section="demo" class:list={{ active: active === 'demo' }} href={`${base}/demo/`}>Demo</a>
        <a href="https://github.com/frostbyte-engine/" target="_blank" rel="noopener">GitHub</a>
        <a data-section="others" class:list={{ active: active === 'others' }} href={`${base}/others/`}>Others</a>
      </nav>
      <span class="spacer"></span>
    </header>

    <main><slot /></main>

    {isHomePage && (
      <script>
        const links = document.querySelectorAll('nav a[data-section]');
        const sections = document.querySelectorAll('section[id]');
        const observer = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((l) =>
              l.classList.toggle('active', l.getAttribute('data-section') === e.target.id)
            );
          }
        }, { rootMargin: '-40% 0px -55% 0px' });
        sections.forEach((s) => observer.observe(s));
      </script>
    )}
  </body>
</html>

<style is:global>
  :root {
    --bg: #ececec;
    --fg: #000;
    --bar-h: 56px;
    --bar-bg: #ececec;
    --hover-bg: rgba(0, 0, 0, 0.12);
    --active-bg: #000;
    --active-fg: #ececec;
  }
  html { scroll-behavior: smooth; scroll-padding-top: var(--bar-h); background: var(--bg); }
  body { margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: var(--bg); color: var(--fg); }

  .topbar {
    position: sticky; top: 0; z-index: 10; height: var(--bar-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 1rem; background: var(--bar-bg); color: var(--fg);
  }
  .topbar .name {
    font-weight: 700; font-size: 1.15rem; letter-spacing: .02em;
    color: inherit; text-decoration: none; justify-self: start;
  }
  .topbar nav { display: flex; gap: .25rem; }
  .topbar nav a {
    color: var(--fg); text-decoration: none; padding: .5rem .9rem;
  }
  .topbar nav a:hover { background: var(--hover-bg); }
  .topbar nav a.active { background: var(--active-bg); color: var(--active-fg); }

  a { color: var(--fg); }
</style>
